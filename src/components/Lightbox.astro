---
import type { Locale } from '~/i18n/config';
import { t } from '~/i18n/ui';
interface Props { locale: Locale }
const { locale } = Astro.props;
---
<dialog id="lightbox" aria-label={t('lightbox.title', locale)}>
  <button id="lightbox-close" type="button">{t('lightbox.close', locale)}</button>
  <img id="lightbox-img" alt="" />
  <p id="lightbox-caption"></p>
</dialog>

<style>
  #lightbox {
    border: none;
    background: var(--void);
    color: var(--ink);
    max-width: min(92vw, 900px);
    padding: 1rem;
    border-radius: 12px;
  }
  #lightbox::backdrop { background: color-mix(in srgb, var(--void) 92%, transparent); }
  #lightbox img { width: 100%; height: auto; border-radius: 8px; display: block; }
  #lightbox-caption {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--dim);
    margin: 0.8rem 0 0;
  }
  #lightbox-close {
    float: right;
    background: none;
    border: 1px solid var(--hair);
    border-radius: 999px;
    color: var(--dim);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.4rem 0.8rem;
    cursor: pointer;
    margin-bottom: 0.6rem;
  }
</style>

<script>
  const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;
  const img = document.getElementById('lightbox-img') as HTMLImageElement | null;
  const caption = document.getElementById('lightbox-caption');
  const close = document.getElementById('lightbox-close');
  if (dialog && img && caption && close) {
    const open = (trigger: HTMLElement) => {
      const source = trigger.querySelector('img');
      if (!source) return;
      // Prefer the full-size derivative the tile carries in `data-full`
      // (GalleryGrid.astro). `currentSrc` is whatever the *tile* resolved —
      // the 300w file on a 1x desktop — and the dialog renders at ~870px, so
      // using it upscales roughly 2.9x. Fall back to it only if the attribute
      // is missing.
      const tileSrc = source.currentSrc || source.src;
      // This is a bare <img> with no <picture> to fall through, so the format
      // chain is walked by hand: full-size AVIF, then full-size WebP, then
      // whatever the tile itself resolved. The WebP rung matters — dropping
      // straight from AVIF to the tile would hand an AVIF-less browser the
      // 300w file and silently upscale it ~2.9x, which is the exact defect
      // the full-size URL exists to prevent.
      const chain = [
        trigger.dataset.full,
        trigger.dataset.fullWebp,
        tileSrc,
      ].filter((src): src is string => Boolean(src));

      let rung = 0;
      img.onerror = () => {
        rung += 1;
        if (rung < chain.length) {
          img.src = chain[rung];
        } else {
          // Every format failed; stop rather than retrying forever.
          img.onerror = null;
        }
      };
      img.src = chain[0];
      img.alt = source.alt;
      caption.textContent = trigger.dataset.caption ?? '';
      dialog.showModal();
    };
    // Tiles are native <button> elements (GalleryGrid.astro), so they're
    // focusable and keyboard-operable by default: a click listener alone is
    // enough, since the browser already fires `click` for both a mouse click
    // and an Enter/Space keypress on a button. No custom keydown handling is
    // needed (and adding one would double-fire the click).
    document.querySelectorAll<HTMLElement>('[data-plate]').forEach((trigger) => {
      trigger.addEventListener('click', () => open(trigger));
    });
    close.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  }
</script>
