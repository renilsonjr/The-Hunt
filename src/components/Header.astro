---
import { localizePath } from '~/i18n/utils';
import { t } from '~/i18n/ui';
import type { Locale, Route } from '~/i18n/config';

interface Props {
  locale: Locale;
  route: Route;
  /**
   * The path this page actually lives at, when that differs from its nav
   * `route`. Defaults to `route`, which is correct for every whole-page
   * route. Dynamic routes with their own counterpart (e.g. a journal entry)
   * pass their own slug path here so the language toggle lands on that
   * entry's translation rather than falling back to the section index.
   */
  pagePath?: string;
}
const { locale, route, pagePath = route } = Astro.props;
const other: Locale = locale === 'en' ? 'pt' : 'en';

// Annotated, not inferred: without it `route` widens to string and a typo'd
// nav route type-checks and ships a link to a 404.
const links: { route: Route; label: string }[] = [
  { route: 'read', label: t('nav.read', locale) },
  { route: 'worlds', label: t('nav.worlds', locale) },
  { route: 'gods', label: t('nav.gods', locale) },
  { route: 'hybrids', label: t('nav.hybrids', locale) },
  { route: 'sphere', label: t('nav.sphere', locale) },
  { route: 'codex', label: t('nav.codex', locale) },
  { route: 'gallery', label: t('nav.gallery', locale) },
  { route: 'journal', label: t('nav.journal', locale) },
];
---
<header class="site-header">
  <a class="wordmark" href={localizePath('', locale)}>
    <span class="the">The</span> <span class="glitch">Hunt</span>
  </a>

  <nav aria-label={t('nav.aria', locale)}>
    {links.map((l) => (
      <a href={localizePath(l.route, locale)} aria-current={route === l.route ? 'page' : undefined}>
        {l.label}
      </a>
    ))}
  </nav>

  <a class="lang" href={localizePath(pagePath, other)} lang={other === 'pt' ? 'pt-BR' : 'en'}>
    {t('lang.switch', locale)}
  </a>
</header>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.6rem;
    padding: 1.1rem var(--gutter);
    border-bottom: 1px solid var(--hair);
  }
  .wordmark {
    font-family: var(--font-display);
    font-size: 1.1rem;
    letter-spacing: 0.06em;
    text-decoration: none;
    color: var(--ink);
  }
  .wordmark .the { color: var(--zalian); }
  .wordmark .glitch { font-family: var(--font-glitch); color: var(--balian); }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
    margin-inline-end: auto;
  }
  nav a {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dim);
    text-decoration: none;
  }
  nav a:hover, nav a[aria-current='page'] { color: var(--ink); }
  nav a[aria-current='page'] { border-bottom: 1px solid var(--zalian); }
  .lang {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    color: var(--virden);
    text-decoration: none;
    border: 1px solid var(--hair);
    border-radius: 999px;
    padding: 0.4rem 0.8rem;
  }
  .lang:hover { border-color: var(--virden); }

  /*
   * Touch. The nav is eight mono links at 0.72rem, which is a 19px-tall hit
   * box — fine under a cursor, awkward under a thumb. Growing them costs two
   * lines and no visual change, since the extra height is padding.
   *
   * Two things claw back the height that buys. The row gap goes to zero,
   * because once each link is 44px tall its own padding separates the rows;
   * and the header's vertical padding shrinks, because that padding existed
   * to give 19px links breathing room they now carry themselves.
   *
   * Measured at 375x812: 189px before, 211px after. Twenty-two pixels of a
   * phone screen is a fair price for eleven reachable targets.
   */
  @media (pointer: coarse) {
    .site-header { padding-block: 0.5rem; }
    nav { row-gap: 0; }
    nav a {
      display: inline-flex;
      align-items: center;
      min-height: var(--tap);
    }
    .lang {
      display: inline-flex;
      align-items: center;
      min-height: var(--tap);
    }
  }
</style>
