---
import StoryPage from '~/layouts/StoryPage.astro';
import ProseBody from '~/components/ProseBody.astro';
import SpoilerGate from '~/components/SpoilerGate.astro';
import { getProse } from '~/lib/content';
import { t } from '~/i18n/ui';
import { render } from 'astro:content';

const locale = 'en' as const;

// The codex reads as one continuous document, but Astro's content layer
// pre-renders each entry's Markdown to HTML at build time and `render()`
// looks that compiled output up by collection/id — it cannot be pointed at a
// different `body` string spliced onto a cloned entry at page-render time.
// So the split lives at the content layer instead of an in-page string split:
// codex.md is the open portion and codex-ending.md is the gated portion,
// two entries in the same collection, each rendered normally.
const open = await getProse('codex', locale);
const gated = await getProse('codex-ending', locale);
if (!open || !gated) throw new Error('codex content missing for ' + locale);

const { Content: OpenPart } = await render(open.entry);
const { Content: GatedPart } = await render(gated.entry);
const { data } = open.entry;
---
<StoryPage
  locale={locale}
  route="codex"
  title={data.title}
  description={data.description}
  eyebrow={data.eyebrow}
  heading={data.heading}
>
  <ProseBody variant="codex">
    <OpenPart />
  </ProseBody>

  <SpoilerGate summary={t('gate.summary', locale)} storageKey="codex">
    <ProseBody variant="codex">
      <GatedPart />
    </ProseBody>
  </SpoilerGate>
</StoryPage>
