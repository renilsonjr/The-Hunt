---
import StoryPage from '~/layouts/StoryPage.astro';
import ProseBody from '~/components/ProseBody.astro';
import SpoilerGate from '~/components/SpoilerGate.astro';
import { getProse } from '~/lib/content';
import { t } from '~/i18n/ui';
import { render } from 'astro:content';

const locale = 'pt' as const;

// See src/pages/codex.astro for why the gated ending is a separate content
// entry rather than a runtime split of one entry's body.
const open = await getProse('codex', locale);
const gated = await getProse('codex-ending', locale);
if (!open || !gated) throw new Error('codex content missing for ' + locale);

const { Content: OpenPart } = await render(open.entry);
const { Content: GatedPart } = await render(gated.entry);
const { data } = open.entry;
---
<StoryPage
  locale={locale}
  route="codex"
  title={data.title}
  description={data.description}
  eyebrow={data.eyebrow}
  heading={data.heading}
>
  <ProseBody variant="codex">
    <OpenPart />
  </ProseBody>

  <SpoilerGate summary={t('gate.summary', locale)} storageKey="codex">
    <ProseBody variant="codex">
      <GatedPart />
    </ProseBody>
  </SpoilerGate>
</StoryPage>
