---
import Head from '~/components/Head.astro';
import { HREFLANG, type Locale } from '~/i18n/config';
import { t } from '~/i18n/ui';
import { artWarmup } from '~/data/art';
import '~/styles/global.css';

interface Props {
  locale: Locale;
  route: string;
  title: string;
  description: string;
}

const { locale, route, title, description } = Astro.props;

// Every page renders through this layout, and Astro's build awaits each
// page's render in full before it reads the image registry that getImage()
// populates (see src/data/art.ts for the traced call path). Awaiting the
// already-created warm-up promise here — rather than at art.ts's top level,
// which deadlocks the build — gives that registry-read a real ordering
// guarantee instead of relying on incidental process/event-loop timing.
await artWarmup;
---
<!doctype html>
<html lang={HREFLANG[locale]}>
  <head>
    <Head locale={locale} route={route} title={title} description={description} />
  </head>
  <body>
    <a class="skip-link" href="#main">{t('nav.skip', locale)}</a>
    <slot name="header" />
    <main id="main">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>
