---
import Head from '~/components/Head.astro';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import { HREFLANG, type Locale, type Route } from '~/i18n/config';
import { t } from '~/i18n/ui';
import '~/styles/global.css';

interface Props {
  locale: Locale;
  route: Route;
  title: string;
  description: string;
  /** Keep this page out of search results. Only the 404 page needs it. */
  noindex?: boolean;
  /** See Head's prop of the same name. Defaults to `route` there. */
  pagePath?: string;
}

const { locale, route, title, description, noindex = false, pagePath } = Astro.props;
---
<!doctype html>
<html lang={HREFLANG[locale]}>
  <head>
    <Head
      locale={locale}
      route={route}
      title={title}
      description={description}
      noindex={noindex}
      pagePath={pagePath}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">{t('nav.skip', locale)}</a>
    <Header locale={locale} route={route} pagePath={pagePath} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
