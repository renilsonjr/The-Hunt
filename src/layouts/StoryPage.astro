---
import BaseLayout from '~/layouts/BaseLayout.astro';
import type { Locale, Route } from '~/i18n/config';

interface Props {
  locale: Locale;
  route: Route;
  title: string;
  description: string;
  eyebrow: string;
  heading: string;
  /** See Header's prop of the same name. Defaults to `route` there. */
  togglePath?: string;
}

const { locale, route, title, description, eyebrow, heading, togglePath } = Astro.props;
---
<BaseLayout
  locale={locale}
  route={route}
  title={title}
  description={description}
  togglePath={togglePath}
>
  <article class="page">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{heading}</h1>
    <slot />
  </article>
</BaseLayout>

<style>
  .page {
    padding: clamp(2rem, 6vw, 4rem) var(--gutter);
    max-width: 1000px;
    margin: 0 auto;
  }
  h1 { font-size: clamp(2rem, 5vw, 3rem); }
</style>
